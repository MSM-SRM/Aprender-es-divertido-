{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Servir sitio local (8767)",
      "detail": "Arranca el servidor estatico en http://127.0.0.1:8767/",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\serve.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "group": "build"
    },
    {
      "label": "Abrir sitio local",
      "detail": "Abre la entrada del sitio en el navegador",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "Start-Process 'http://127.0.0.1:8767/peques/index.html?profile=guest'"
      ],
      "problemMatcher": []
    },
    {
      "label": "Auditar referencias entre paginas",
